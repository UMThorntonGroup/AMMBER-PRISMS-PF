@PACKAGE_INIT@

# Interface relies on 'prismspf', so you must find it here
include(CMakeFindDependencyMacro)
find_dependency(PRISMS-PF REQUIRED) 

# Include the targets file generated by CMake (this recreates the AMMBER::ammber target)
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components("@PROJECT_NAME@")
