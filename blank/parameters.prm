set dim = 2
set degree = 1

set global refinement = 9
subsection Rectangular mesh
  set x size = 128.0
  set y size = 128.0
  set z size = 128.0
  set x subdivisions = 1
  set y subdivisions = 1
  set z subdivisions = 1
end

set time step = 1.0e-3

set number steps = 100000
subsection output
  set condition = EQUAL_SPACING
  set number = 100
end

set mesh adaptivity = true
set max refinement = 9
set min refinement = 4
set remeshing period = 250
include BC_AMR.prm

set Model constant r0 = 64.0, DOUBLE

# =================================================================================
# Set the automatic parameter selection constants
# =================================================================================

# Design factor (1/safety factor) for reccommending timestep.
# A value in (0, 1), practically in [0.1, 0.8]
# lower value -> more stable
set Model constant time_scale_stability_factor = 0.5, DOUBLE

# Number of points in interface when automatically selecting length scale
# n > 4 reccommended
set Model constant num_points_in_interface = 6.0, DOUBLE